{
  "name": "finance-briefing-agent",
  "version": "1.0.0",
  "description": "Global macro x AI industry daily briefing pipeline",
  "type": "module",
  "scripts": {
    "v2": "tsx src/scripts/run-v2.ts",
    "daily": "npm run v2 && npm run send-email && npm run send-telegram",
    "send-email": "tsx src/scripts/send-email.ts",
    "send-telegram": "tsx src/scripts/send-telegram.ts",
    "v2:attach-image": "tsx src/scripts/v2-attach-image.ts",
    "narrate": "tsx src/scripts/narrate.ts",
    "send-narration": "tsx src/scripts/send-narration.ts",
    "publish-narration": "tsx src/scripts/publish-narration.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "finance",
    "macro",
    "briefing",
    "ai",
    "market"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3",
    "https-proxy-agent": "^7.0.6",
    "marked": "^17.0.1",
    "nodemailer": "^7.0.12",
    "rss-parser": "^3.13.0",
    "yahoo-finance2": "^3.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.5",
    "puppeteer": "^24.36.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
