# ============================================
# 数据源
# ============================================

# Finnhub（可选）：财报日历 + general 新闻。https://finnhub.io/
FINNHUB_API_KEY=

# Tavily（可选）：研究步骤的搜索与正文抽取。未设置则跳过搜索。https://tavily.com/
TAVILY_API_KEY=

# ============================================
# LLM
# 各步骤用哪个模型在 config/llm-profiles.json 里配置，这里只放密钥
# ============================================
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# 按步骤覆盖模型 profile（可选）。步骤: TRIAGE | SYNTHESIS | WATCHLIST | PORTFOLIO
# LLM_STEP_SYNTHESIS=claude

# ============================================
# 真实持仓（可选）
# JSON 数组，tier 为 core 或 satellite，costBasis 可选。
# 只进入 portfolio 步骤，产出私人简报，只通过 Telegram 发送；公开简报看不到它。
# 也可放在 data/private/holdings.json（已 gitignore）
# ============================================
# HOLDINGS_JSON=[{"ticker":"NVDA","tier":"core","costBasis":120},{"ticker":"TSM","tier":"core"}]

# ============================================
# 邮件（公开简报）
# ============================================
EMAIL_ENABLED=false
EMAIL_TO=
EMAIL_FROM=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
# Gmail 用 App Password
EMAIL_SMTP_PASS=

# ============================================
# Telegram（摘要 + 公开 PDF + 私人 PDF）
# ============================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
