---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PulseLog from '../components/PulseLog.astro';

const reports = (await getCollection('reports'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = new Map<string, typeof reports>();
for (const r of reports) {
  const month = r.data.dateStr.slice(0, 7);
  if (!grouped.has(month)) grouped.set(month, []);
  grouped.get(month)!.push(r);
}
---

<BaseLayout title="脉动日志 - 鬼哥的 AI 行业每日简报" description="每日 Regime 一行，往下看市场状态怎么变">
  <h1 class="mt-6 text-3xl">脉动日志</h1>
  <p class="mb-8 mt-1 text-pencil">每日 Regime 一行，往下看市场状态怎么变。共 {reports.length} 期。</p>

  {reports.length === 0 ? (
    <p class="py-20 text-center text-pencil">暂无报告</p>
  ) : (
    [...grouped.entries()].map(([month, items]) => (
      <section class="mb-10">
        <h2 class="border-b-2 border-ink pb-2 text-xl">{month}</h2>
        <PulseLog reports={items} />
      </section>
    ))
  )}
</BaseLayout>
