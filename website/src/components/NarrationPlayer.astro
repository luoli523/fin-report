---
import { findNarration } from '../lib/narration';
interface Props { date: string }
const { date } = Astro.props;
const audio = findNarration(date);
const seconds = Math.round(audio?.duration || 0);
const duration = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---
{audio && (
  <div class="narration mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-rule bg-paper-2 px-4 py-3" aria-label={`${date} 公开简报播报`}>
    <span class="font-display text-base font-bold text-ink">听鬼哥讲今日重点 <span class="ml-1 text-sm font-normal text-pencil tabular-nums">{duration}</span></span>
    <audio controls preload="metadata" class="h-9 min-w-0 flex-1 basis-64" aria-label={`${date} 投资播报`}>
      <source src={audio.url} type="audio/mpeg" />
      你的浏览器不支持音频播放，请使用下载链接收听。
    </audio>
    <a href={audio.url} class="text-xs text-hoodie">下载音频</a>
  </div>
)}

<style>
  .narration audio { accent-color: #F28C28; }
</style>
