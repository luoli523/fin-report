---
const base = '/fin-report';
const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === base || path === '';
const isArchive = path.startsWith(`${base}/archive`);
---

<header class="border-b border-rule">
  <nav class="mx-auto flex max-w-[880px] items-center justify-between gap-4 px-4 py-4">
    <a href={base} class="flex items-center gap-3 text-ink hover:no-underline">
      <img
        src={`${base}/images/guige-avatar.png`}
        alt="鬼哥"
        class="h-10 w-10 rounded-full border-2 border-headband object-cover object-[28%_30%]"
      />
      <span class="font-display text-lg font-bold leading-tight sm:text-xl">鬼哥的 AI 行业每日简报</span>
    </a>

    <div class="flex shrink-0 items-center gap-4 whitespace-nowrap text-sm sm:gap-5">
      <a href={base} class:list={[isHome ? 'text-ink' : 'text-pencil hover:text-ink']} aria-current={isHome ? 'page' : undefined}>首页</a>
      <a href={`${base}/archive`} class:list={[isArchive ? 'text-ink' : 'text-pencil hover:text-ink']} aria-current={isArchive ? 'page' : undefined}>脉动日志</a>
      <a href={`${base}/rss.xml`} target="_blank" class="text-pencil hover:text-ink" title="RSS 订阅">RSS</a>
    </div>
  </nav>
</header>
